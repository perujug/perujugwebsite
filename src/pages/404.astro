---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada | PeruJUG"
  description="La página que buscas no existe o fue movida."
>
  <section class="container-prose max-w-3xl py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)]">
      Error 404
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
      Esta página no existe
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-[var(--color-fg-muted)]">
      Es posible que el enlace esté roto o que la página haya sido movida durante la
      modernización del sitio. Puedes volver al inicio o explorar el blog y los eventos.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-md bg-peru-red px-5 py-3 text-sm font-semibold text-white shadow hover:bg-[var(--color-link-hover)]"
      >
        Volver al inicio
      </a>
      <a
        href="/blog/"
        class="inline-flex items-center justify-center rounded-md border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-5 py-3 text-sm font-semibold hover:border-[var(--color-link-hover)]"
      >
        Ir al blog
      </a>
      <a
        href="/eventos/"
        class="inline-flex items-center justify-center rounded-md border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-5 py-3 text-sm font-semibold hover:border-[var(--color-link-hover)]"
      >
        Ver eventos
      </a>
    </div>
  </section>
</BaseLayout>
