---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatDateShort } from '@/utils/dates';

const features = [
  {
    title: 'Java moderno',
    description:
      'Exploramos virtual threads, pattern matching, structured concurrency y todas las novedades que llegan con Java 21 LTS y Java 25 LTS.',
  },
  {
    title: 'Comunidad activa',
    description:
      'Meetups, charlas tecnicas y mentoria entre desarrolladores con experiencia y quienes recien empiezan en el ecosistema Java.',
  },
  {
    title: 'Open Source y Cloud',
    description:
      'Spring, Quarkus, Jakarta EE y despliegues sobre Kubernetes. Construimos software abierto, observable y listo para la nube.',
  },
];

const organizers = [
  {
    name: 'Jose Diaz',
    role: 'Java Champion - JUG Leader',
    photo: '/images/organizer-joe.jpg',
  },
  {
    name: 'Ytalo Borja',
    role: 'JUG Leader',
    photo: '/images/organizer-ytalo.borja.jpg',
  },
  {
    name: 'Carlos Zela',
    role: 'JUG Leader',
    photo: '/images/organizer-carlos.zela.jpg',
  },
  {
    name: 'Eddu Melendez',
    role: 'Java Champion - JUG Leader',
    photo: '/images/organizer-eddu.jpg',
  },
];

const allPosts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
const latestPosts = allPosts
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="PeruJUG - Comunidad Java de Peru"
  description="PeruJUG es la comunidad peruana de desarrolladores Java. Organizamos meetups, charlas y la conferencia Java Day Peru."
>
  <section class="relative overflow-hidden">
    <img
      src="/images/perujug2023.png"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-20 dark:opacity-25"
      loading="eager"
      decoding="async"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-bg)]/40 via-[var(--color-bg)]/70 to-[var(--color-bg)]"></div>
    <div class="container-prose relative max-w-6xl py-24 sm:py-32">
      <p class="text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)]">
        Peru Java User Group
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-6xl">
        Comunidad Java de Peru
      </h1>
      <p class="mt-4 max-w-2xl text-xl text-[var(--color-fg-muted)]">
        Comunidad de @java en Peru. Aprendemos, ensenamos y construimos juntos sobre la JVM.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="https://www.meetup.com/Peru-Java-User-Group/"
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center justify-center rounded-md bg-peru-red px-5 py-3 text-sm font-semibold text-white shadow hover:bg-[var(--color-link-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        >
          Unete en Meetup
        </a>
        <a
          href="/eventos/"
          class="inline-flex items-center justify-center rounded-md border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-5 py-3 text-sm font-semibold hover:border-[var(--color-link-hover)]"
        >
          Ver eventos
        </a>
      </div>
    </div>
  </section>

  <section class="container-prose max-w-6xl py-16">
    <h2 class="text-3xl font-bold tracking-tight">Por que PeruJUG</h2>
    <p class="mt-2 max-w-2xl text-[var(--color-fg-muted)]">
      Tres ejes que mueven a la comunidad cada ano.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        features.map((feature) => (
          <article class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
            <h3 class="text-lg font-semibold">{feature.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-fg-muted)]">{feature.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-[var(--color-bg-elevated)]">
    <div class="container-prose max-w-6xl py-16">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl font-bold tracking-tight">Organizadores</h2>
          <p class="mt-2 max-w-2xl text-[var(--color-fg-muted)]">
            Las personas que mueven la comunidad PeruJUG.
          </p>
        </div>
        <a href="/equipo/" class="text-sm font-semibold hover:text-[var(--color-link-hover)]">
          Ver equipo completo &rarr;
        </a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          organizers.map((person) => (
            <article class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] p-6 text-center">
              <img
                src={person.photo}
                alt={`Foto de ${person.name}`}
                width="128"
                height="128"
                loading="lazy"
                decoding="async"
                class="mx-auto h-32 w-32 rounded-full object-cover"
              />
              <h3 class="mt-4 text-base font-semibold">{person.name}</h3>
              <p class="mt-1 text-sm text-[var(--color-fg-muted)]">{person.role}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="container-prose max-w-6xl py-16">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 class="text-3xl font-bold tracking-tight">Ultimas publicaciones</h2>
            <p class="mt-2 max-w-2xl text-[var(--color-fg-muted)]">
              Notas, resumenes de eventos y anuncios de la comunidad.
            </p>
          </div>
          <a href="/blog/" class="text-sm font-semibold hover:text-[var(--color-link-hover)]">
            Ver todo el blog &rarr;
          </a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {latestPosts.map((post: CollectionEntry<'blog'>) => (
            <article class="flex flex-col rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
              <p class="text-xs uppercase tracking-wider text-[var(--color-fg-muted)]">
                {formatDateShort(post.data.pubDate)}
              </p>
              <h3 class="mt-2 text-lg font-semibold">
                <a href={`/blog/${post.slug}/`} class="hover:text-[var(--color-link-hover)]">
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-2 flex-1 text-sm text-[var(--color-fg-muted)]">{post.data.description}</p>
              <a
                href={`/blog/${post.slug}/`}
                class="mt-4 text-sm font-semibold hover:text-[var(--color-link-hover)]"
              >
                Leer mas &rarr;
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-elevated)]">
    <div class="container-prose max-w-6xl py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight">Suma tu voz a la comunidad</h2>
      <p class="mx-auto mt-3 max-w-2xl text-[var(--color-fg-muted)]">
        Participa de los proximos meetups, propon una charla o conoce a otros desarrolladores Java en Peru.
      </p>
      <div class="mt-6 flex justify-center">
        <a
          href="https://www.meetup.com/Peru-Java-User-Group/"
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center justify-center rounded-md bg-peru-red px-6 py-3 text-sm font-semibold text-white shadow hover:bg-[var(--color-link-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        >
          Unete en Meetup
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
