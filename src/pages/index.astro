---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="PeruJUG - Comunidad Java de Peru"
  description="PeruJUG es la comunidad peruana de desarrolladores Java. Organizamos meetups, talleres y la conferencia anual JConf Peru."
>
  <section class="container-prose py-16 max-w-6xl">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">PeruJUG</h1>
    <p class="mt-4 max-w-prose text-lg text-[var(--color-fg-muted)]">
      Bienvenido al sitio de la comunidad Java de Peru. Este es un placeholder del nuevo sitio Astro;
      el contenido completo se construira en las siguientes iteraciones.
    </p>
  </section>
</BaseLayout>
