---
import BaseLayout from '@/layouts/BaseLayout.astro';

const organizers = [
  {
    name: 'Jose Diaz',
    role: 'Java Champion - JUG Leader',
    photo: '/images/organizer-joe.jpg',
    bio: 'Java Champion, lider de PeruJUG y organizador de Java Day Peru y JConf Peru.',
  },
  {
    name: 'Ytalo Borja',
    role: 'JUG Leader',
    photo: '/images/organizer-ytalo.borja.jpg',
    bio: 'Coorganizador de PeruJUG, apasionado por la JVM y la formacion de nuevos desarrolladores.',
  },
  {
    name: 'Carlos Zela',
    role: 'JUG Leader',
    photo: '/images/organizer-carlos.zela.jpg',
    bio: 'Coorganizador de PeruJUG, enfocado en arquitectura de aplicaciones empresariales sobre Java.',
  },
  {
    name: 'Eddu Melendez',
    role: 'Java Champion - JUG Leader',
    photo: '/images/organizer-eddu.jpg',
    bio: 'Java Champion, contribuidor de Spring y organizador de eventos Java en Peru y Latinoamerica.',
  },
];
---

<BaseLayout
  title="Equipo | PeruJUG"
  description="Conoce al equipo organizador de PeruJUG, la comunidad peruana de desarrolladores Java."
>
  <section class="container-prose max-w-5xl py-16">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Equipo</h1>
    <p class="mt-3 max-w-2xl text-lg text-[var(--color-fg-muted)]">
      PeruJUG es posible gracias a un equipo de personas que dedican su tiempo a organizar
      meetups, charlas y conferencias. Estos son los organizadores actuales.
    </p>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        organizers.map((person) => (
          <li class="flex flex-col rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6 sm:flex-row sm:items-start sm:gap-6">
            <img
              src={person.photo}
              alt={`Foto de ${person.name}`}
              width="128"
              height="128"
              loading="lazy"
              decoding="async"
              class="h-32 w-32 shrink-0 rounded-full object-cover"
            />
            <div class="mt-4 sm:mt-0">
              <h2 class="text-lg font-semibold">{person.name}</h2>
              <p class="text-sm text-[var(--color-accent)]">{person.role}</p>
              <p class="mt-2 text-sm text-[var(--color-fg-muted)]">{person.bio}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
